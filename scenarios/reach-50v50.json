{
  "description": "One full battle, 50 against 50: the case the server is built for. Needs the server's /metrics (localhost, or --metrics-token).",
  "target": "reach",
  "vus": 100,
  "ramp": "10s",
  "duration": "60s",
  "thresholds": [
    "vu.connect_failed:count==0",
    "vu.lost:count==0",
    "reach.decode_error:count==0",
    "reach.snapshot_loss<1%",
    "reach.snapshot_ratio>90%",
    "reach.rtt:p99<100ms",
    "server.reach_tick_ms:p99<=33ms",
    "server.reach_udp_drops:count==0"
  ]
}
